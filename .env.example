# RootTrace AI — environment template.
#
# Copy to .env.local and fill in. Canonical variable reference is
# docs/appendix/A3-CONFIGURATION.md §1; this file is the local-development
# shape from §5. Every value is validated by a Pydantic Settings class at boot
# and the process REFUSES TO START on a missing or invalid one — there are no
# silent defaults for anything security-relevant (A3 §6).
#
# ─────────────────────────────────────────────────────────────────────────────
# Every value here is deliberately fake and obviously so (REPLACE_ME). That is
# a security property, not laziness: this is the one env file that is tracked
# in git, so a real key pasted here must stand out at a glance rather than
# blending into something that looks plausibly like a placeholder.
# .gitleaks.toml allowlists this path — do not put a real secret in it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
RT_ENVIRONMENT=local
# evaluation = V1. Structurally cannot reach a customer repository: it holds no
# GitHub App key, so it cannot mint an installation token (A3 §1.1).
RT_DEPLOYMENT_TIER=evaluation
RT_VERSION=dev
RT_LOG_LEVEL=debug
RT_SERVICE_NAME=api

# ── Database ─────────────────────────────────────────────────────────────────
RT_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Redis ────────────────────────────────────────────────────────────────────
RT_REDIS_URL=redis://localhost:6379/0

# ── Supabase ─────────────────────────────────────────────────────────────────
# Fill from `supabase status` after `make db-reset`.
RT_SUPABASE_URL=http://localhost:54321
RT_SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY
# WORKER ONLY. Bypasses RLS. A boot invariant refuses to start `api` if this is
# set (A3 §6) — leave it empty in an api environment.
RT_SUPABASE_SERVICE_ROLE_KEY=
# Asymmetric public key set. There is no shared signing secret: RT_SUPABASE_JWT_SECRET
# is retired (B12), because a signing key in `api` would let a compromised API
# process mint valid tokens for any user. A public key cannot.
RT_SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json

# ── GitHub ───────────────────────────────────────────────────────────────────
# fixture throughout V1. The client is fully implemented; V2 flips this value,
# not code. `live` is refused at boot while RT_DEPLOYMENT_TIER=evaluation.
RT_GITHUB_MODE=fixture
RT_GITHUB_FIXTURE_PATH=fixtures/synthetic-repo
# OAuth login is OPTIONAL locally (A3 §5.1). Leave both unset and Supabase
# magic link is used instead — same JWT, same `sub`, same RLS behaviour.
# There is no dev-mode auth bypass.
# RT_GITHUB_CLIENT_ID=REPLACE_ME
# RT_GITHUB_CLIENT_SECRET=REPLACE_ME

# ── LLM ──────────────────────────────────────────────────────────────────────
RT_ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# RT_OPENAI_API_KEY=sk-REPLACE_ME
# RT_VOYAGE_API_KEY=pa-REPLACE_ME

# ── Sandbox ──────────────────────────────────────────────────────────────────
RT_SANDBOX_ENABLED=true
# gVisor is required in production and often unavailable locally.
RT_SANDBOX_RUNTIME=runc
RT_SANDBOX_CONCURRENCY=2
# Hard SIGKILL. The p95 TARGET is 45 s and is a separate number (B11) — never
# conflate them, and never lower this to make a p95 look better.
RT_SANDBOX_TIMEOUT_SECONDS=90

# ── Feature flags ────────────────────────────────────────────────────────────
# Asserted true in every environment. Disabling it turns off the primary
# anti-hallucination control (H1) and nothing visibly breaks — which is exactly
# why it is a boot invariant rather than a preference.
RT_FF_STRICT_EVIDENCE_BINDING=true
