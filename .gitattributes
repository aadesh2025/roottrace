# Normalise line endings. Without this, a Windows checkout writes CRLF into
# shell scripts and SQL migrations, both of which run on Linux in CI and in
# containers. `sh` on CRLF fails with an unreadable "\r: command not found".
* text=auto eol=lf

*.sh      text eol=lf
*.sql     text eol=lf
Makefile  text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Collapsed by default in the GitHub UI and excluded from language stats — but
# NOT marked `-diff`. A lockfile diff is precisely what a reviewer needs to see
# when a dependency changes; suppressing it would hide the shape of a
# supply-chain compromise from the review that exists to catch it.
uv.lock        linguist-generated=true
pnpm-lock.yaml linguist-generated=true
